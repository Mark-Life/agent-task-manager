{
  "tailwindCSS.experimental.configFile": "packages/ui/src/styles/globals.css",
  "editor.defaultFormatter": "biomejs.biome",

  // TypeScript 7 is a native binary. It ships no `tsserver`, so the built-in
  // extension's JavaScript language service cannot run it — `typescript.tsdk`
  // used to point at `node_modules/typescript/lib`, which under 7 holds a
  // `tsc.js` shim and nothing else, and leaving it there breaks the editor
  // outright. These four settings replace it.
  //
  // `useTsgo` switches the TypeScript Native Preview extension
  // (`TypeScriptTeam.native-preview`, see extensions.json) on as the language
  // server. `tsdk.path` then points it at the workspace compiler rather than
  // the tsgo the extension bundles, which matters here: the root `prepare`
  // script runs `effect-tsgo patch`, replacing that binary with `@effect/tsgo`
  // — a superset of tsgo carrying the Effect language service. Pointing at it
  // is what gives the editor the same Effect diagnostics `bun run typecheck`
  // reports, from a single server. Running the bundled tsgo alongside it would
  // duplicate every diagnostic.
  //
  // `bin`, not `lib`: the extension resolves a tsdk directory to an executable
  // the same way `node_modules/typescript/lib/getExePath.js` does.
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/typescript/bin",
  "js/ts.tsdk.additionalLocations": ["./node_modules/typescript/bin"],
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,

  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "emmet.showExpandedAbbreviation": "never",
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[html]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[vue]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[svelte]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[yaml]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[graphql]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[markdown]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[mdx]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "tailwindCSS.classFunctions": [
    "cn",
    "cva",
    "tv",
    "clsx",
    "twMerge",
    "twJoin",
    "tw"
  ],
  "npm.packageManager": "bun",
  "files.exclude": {
    "**/.turbo": true,
    "**/*.tsbuildinfo": true,
    "**/.DS_Store": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/bun.lock": true,
    "**/*.tsbuildinfo": true
  },
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true
  }
}
