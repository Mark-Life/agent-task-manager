{
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "4.0.0-beta.102",
    "@effect/tsgo": "0.34.0",
    "@types/bun": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "alchemy": "2.0.0-beta.67",
    "effect": "catalog:",
    "husky": "^9.1.7",
    "portless": "^0.15.4",
    "turbo": "^2.10.5",
    "typescript": "7.0.2",
    "ultracite": "7.9.4"
  },
  "name": "netxjs-monorepo",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "bun run check",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "logs": "bun run scripts/logs.ts",
    "service": "bun run scripts/service.ts help",
    "service:install": "bun run scripts/service.ts install",
    "service:status": "bun run scripts/service.ts status",
    "service:logs": "bun run scripts/service.ts logs",
    "service:start": "bun run scripts/service.ts start",
    "service:stop": "bun run scripts/service.ts stop",
    "service:restart": "bun run scripts/service.ts restart",
    "service:uninstall": "bun run scripts/service.ts uninstall",
    "openapi": "bun run scripts/openapi.ts",
    "loop:dev": "bun run --watch apps/loop/src/main.ts",
    "loop:start": "bun run apps/loop/src/main.ts",
    "bot:dev": "bun run --watch apps/bot/src/main.ts",
    "bot:start": "bun run apps/bot/src/main.ts",
    "format": "bun run fix",
    "check": "bunx --bun ultracite check",
    "fix": "bunx --bun ultracite fix",
    "prepare": "husky && effect-tsgo patch --typescript --no-oxlint",
    "upgrade": "bun run scripts/upgrade.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "bun run --cwd packages/db --bun drizzle-kit migrate",
    "db:migrations-check": "bun run --cwd packages/db db:migrations-check",
    "db:seed": "bun run scripts/seed.ts",
    "db:seed:demo": "bun run scripts/seed-demo.ts",
    "db:store-check": "bun run scripts/store-check.ts",
    "backup": "bun run scripts/backup.ts take",
    "backup:list": "bun run scripts/backup.ts list",
    "backup:verify": "bun run scripts/backup.ts verify",
    "backup:prune": "bun run scripts/backup.ts prune",
    "user:add": "bun run scripts/user-add.ts",
    "agent-home:login": "bun run scripts/agent-home-login.ts",
    "github:check": "bun run scripts/github-check.ts",
    "harness:check": "bun run scripts/harness-check.ts",
    "sandbox:check": "bun run scripts/sandbox-check.ts",
    "loop:check": "bun run scripts/loop-check.ts",
    "quota:check": "bun run scripts/quota-check.ts",
    "dashboard:dev": "turbo dev --filter=gateway --filter=dashboard",
    "dashboard:build": "bun run --cwd apps/dashboard build",
    "dashboard:budget": "bun run scripts/dashboard-budget.ts",
    "dashboard:publish": "rsync -a --delete apps/dashboard/dist/ \"${ATM_DASHBOARD_ROOT:?set it to the directory Caddy serves the dashboard from}\"/",
    "gateway:dev": "bun run --watch apps/gateway/src/main.ts",
    "gateway:start": "bun run apps/gateway/src/main.ts",
    "gateway:token": "bun run apps/gateway/src/auth/mint.ts",
    "gateway:check": "bun run scripts/gateway-check.ts",
    "bot:check": "bun run scripts/bot-check.ts",
    "images:build": "bun run scripts/build-images.ts",
    "entrypoint:build": "bun run scripts/build-entrypoint.ts",
    "agent-mcp:build": "bun run scripts/build-agent-mcp.ts",
    "cf:plan": "alchemy plan",
    "cf:deploy": "alchemy deploy",
    "cf:dev": "alchemy dev",
    "cf:destroy": "alchemy destroy"
  },
  "type": "module",
  "version": "0.0.1",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "effect": "4.0.0-beta.102",
      "@effect/platform-bun": "4.0.0-beta.102",
      "@effect/sql-pg": "4.0.0-beta.102",
      "@anthropic-ai/claude-agent-sdk": "0.3.220",
      "@openai/codex-sdk": "0.146.0",
      "grammy": "^1.45.1",
      "zod": "^4.4.3",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "lucide-react": "^1.25.0",
      "next-themes": "^0.4.6",
      "tailwindcss": "^4.3.3",
      "@tailwindcss/postcss": "^4.3.3",
      "@tailwindcss/vite": "^4.3.3",
      "@types/bun": "^1.3.14",
      "@types/node": "^26.1.1"
    }
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.3.0"
  }
}
