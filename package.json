{
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "^1.3.14",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "portless": "^0.15.4",
    "turbo": "^2.10.5",
    "typescript": "6.0.3",
    "ultracite": "7.9.4"
  },
  "name": "netxjs-monorepo",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "bun run check",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "logs": "bun run scripts/logs.ts",
    "format": "bun run fix",
    "check": "bunx --bun ultracite check",
    "fix": "bunx --bun ultracite fix",
    "prepare": "husky",
    "upgrade": "bun run scripts/upgrade.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "bun run scripts/seed.ts",
    "db:store-check": "bun run scripts/store-check.ts",
    "harness:check": "bun run scripts/harness-check.ts"
  },
  "version": "0.0.1",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "effect": "4.0.0-beta.102",
      "@effect/platform-bun": "4.0.0-beta.102",
      "@effect/sql-pg": "4.0.0-beta.102"
    }
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.3.0"
  }
}
