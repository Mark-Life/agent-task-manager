{
  "extends": ["ultracite/biome/core", "ultracite/biome/next"],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "apps/**/*.ts",
      "apps/**/*.tsx",
      "packages/**/*.ts",
      "packages/**/*.tsx",
      "!node_modules/**/*",
      "!dist/**/*",
      // Derived from packages/api by `bun run openapi`, never hand-edited, so
      // the formatter has no say: reflowing it would only make every
      // regeneration a diff.
      "!openapi.json",
      "!packages/ui/src/components/**/*",
      "!packages/ui/src/hooks/**/*",
      "!packages/ui/src/lib/**/*"
    ]
  },
  // Biome 2.5's HTML formatter is not idempotent over a block comment inside an
  // embedded <style> or <script>: every pass indents the comment's continuation
  // lines again, so `apps/dashboard/index.html` came back changed from each
  // pre-commit run. The repository has one HTML file and it is hand-written.
  "html": {
    "formatter": {
      "enabled": false
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off",
        "noConsole": "off"
      },
      "style": {
        "noMagicNumbers": "warn",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "interface"
          }
        }
      },
      "correctness": {
        "noUndeclaredVariables": {
          "level": "error",
          "options": {
            "checkTypes": true
          }
        }
      },
      "performance": {
        "noNamespaceImport": "off",
        "noBarrelFile": "off"
      }
    }
  }
}
