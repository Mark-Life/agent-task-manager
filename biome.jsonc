{
  "extends": ["ultracite/biome/core", "ultracite/biome/next"],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "apps/**/*.ts",
      "apps/**/*.tsx",
      "packages/**/*.ts",
      "packages/**/*.tsx",
      "!node_modules/**/*",
      "!dist/**/*",
      // Derived from packages/api by `bun run openapi`, never hand-edited, so
      // the formatter has no say: reflowing it would only make every
      // regeneration a diff.
      "!openapi.json",
      "!packages/ui/src/components/**/*",
      "!packages/ui/src/hooks/**/*",
      "!packages/ui/src/lib/**/*"
    ]
  },
  // Biome 2.5's HTML formatter is not idempotent over a block comment inside an
  // embedded <style> or <script>: every pass indents the comment's continuation
  // lines again, so `apps/dashboard/index.html` came back changed from each
  // pre-commit run. The repository has one HTML file and it is hand-written.
  "html": {
    "formatter": {
      "enabled": false
    }
  },
  "overrides": [
    {
      // tsconfig files are JSONC by specification — TypeScript has always
      // parsed comments in them — but biome applies strict JSON to anything
      // named `.json`. The shared configs in packages/typescript-config carry
      // the reasoning for the Effect language service's per-rule severities,
      // which belongs next to the severities rather than in a README nobody
      // opens while editing them.
      "includes": ["**/tsconfig*.json", "packages/typescript-config/*.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      // Two lookup tables whose entire content is numbers somebody else chose:
      // a vendor's published price per million tokens, and a model's context
      // window. Naming each one would produce sixty constants named after the
      // number they hold. Both files carry the date their figures were read and
      // the page they were read from, which is the provenance the rule is
      // reaching for.
      "includes": [
        "packages/domain/src/model-price.ts",
        "packages/harness/src/model-window.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      // Atlas is a Bun CLI that happens to live under `packages/`: it reads
      // `Bun.argv`, scans with `Bun.Glob`, and calls `Bun.file`, `Bun.build`,
      // `Bun.write` and `Bun.spawn` directly. Biome does not read `@types/bun`,
      // so `noUndeclaredVariables` needs the global declared — for this one
      // directory rather than repo-wide.
      "includes": ["packages/atlas/**"],
      "javascript": {
        "globals": ["Bun"]
      }
    },
    {
      // The dashboard's icon generator: a drawing and a file format, and both
      // of them are numbers by nature. `mark.ts` is the mark itself — the
      // coordinates of three lanes and three cards in a hundred-unit square,
      // where naming each one produces `const SIX = 6`. `png.ts` writes the
      // container those pixels ship in: a CRC-32 and a chunk header, whose
      // constants and whose bit shifts are the PNG specification rather than a
      // choice anybody here made, and neither is expressible without `^`, `&`
      // and `>>>`. Both files are covered by tests that render and re-read what
      // they produce.
      "includes": [
        "apps/dashboard/tools/mark.ts",
        "apps/dashboard/tools/png.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          },
          "suspicious": {
            "noBitwiseOperators": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off",
        "noConsole": "off"
      },
      "style": {
        "noMagicNumbers": "warn",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "interface"
          }
        }
      },
      "correctness": {
        "noUndeclaredVariables": {
          "level": "error",
          "options": {
            "checkTypes": true
          }
        }
      },
      "performance": {
        "noNamespaceImport": "off",
        "noBarrelFile": "off"
      }
    }
  }
}
