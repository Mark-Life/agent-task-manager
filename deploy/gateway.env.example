# /etc/agent-task-manager/gateway.env — what only the gateway needs.
#
# Copy, fill in, `chown root:atm`, `chmod 0640`.

# Loopback only. Caddy is the way in; a gateway bound to 0.0.0.0 is one that
# answers on the VPS's public IP without a certificate in front of it.
GATEWAY_PORT=3100

# The origin the outside world reaches this gateway on, which is Caddy's, not
# the port above. It is stamped into `servers[0].url` of the document served at
# /openapi.json — so getting it wrong means a connector that reads the spec
# correctly and then calls localhost.
GATEWAY_PUBLIC_URL=https://api.example.com

# How long a stop may take before the process exits non-zero on its own. Must
# stay under the unit's TimeoutStopSec, or systemd's SIGKILL arrives first and
# the reason is lost.
GATEWAY_SHUTDOWN_GRACE_MS=15000

# How much of its own traffic this gateway keeps in the event ledger. A request
# is the one unit of work here whose volume follows a dashboard being open
# rather than work being done, so everything that failed, streamed, or ran past
# its route's p99 is stored and one in this many of the rest — each stored row
# carrying the number of requests it stands for. `atm_requests_total` is updated
# above that decision and still counts every one. Set to 1 to store them all.
GATEWAY_SAMPLE_ONE_IN=20

# BETTER_AUTH_SECRET and BETTER_AUTH_URL are deliberately not here. All three
# processes need the same secret — see common.env — and a copy in this file is
# a second place for it to drift from.

# The registrable domain the dashboard and this gateway share, leading dot
# included. It widens the session cookie so dash.example.com and
# api.example.com are one site to the browser, which is what keeps the cookie
# first-party — a cookie that is third-party is dropped by Safari and Firefox
# whether or not it says Partitioned. The two hosts must sit under this domain,
# and BETTER_AUTH_URL must be set, or the gateway refuses to start.
AUTH_COOKIE_DOMAIN=.example.com
