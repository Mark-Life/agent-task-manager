# /etc/agent-task-manager/gateway.env — what only the gateway needs.
#
# Copy, fill in, `chown root:atm`, `chmod 0640`.

# Loopback only. Caddy is the way in; a gateway bound to 0.0.0.0 is one that
# answers on the VPS's public IP without a certificate in front of it.
GATEWAY_PORT=3100

# The origin the outside world reaches this gateway on, which is Caddy's, not
# the port above. It is stamped into `servers[0].url` of the document served at
# /openapi.json — so getting it wrong means a connector that reads the spec
# correctly and then calls localhost.
GATEWAY_PUBLIC_URL=https://api.example.com

# How long a stop may take before the process exits non-zero on its own. Must
# stay under the unit's TimeoutStopSec, or systemd's SIGKILL arrives first and
# the reason is lost.
GATEWAY_SHUTDOWN_GRACE_MS=15000

# The root secret, and the gateway does not boot without it. It signs the
# browser's session cookie and, under a separate derived key, every scoped
# bearer token. Generate with `openssl rand -base64 32`. Rotating it is the only
# revocation there is: it invalidates every session and every outstanding token
# at once.
BETTER_AUTH_SECRET=CHANGEME

# The origin the auth library builds its callback and cookie URLs from. Same
# value as GATEWAY_PUBLIC_URL. Left unset it is guessed from each request, which
# works until something forwards a header that says otherwise.
BETTER_AUTH_URL=https://api.example.com
