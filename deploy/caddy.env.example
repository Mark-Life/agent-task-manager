# /etc/agent-task-manager/caddy.env — what the Caddyfile reads.
#
# Copy, fill in, `chown root:caddy`, `chmod 0640`. Reached by Caddy through the
# drop-in in `caddy-override.conf`; the stock caddy.service reads no environment
# file of its own.

# The gateway's address. Its A/AAAA record must already point at this host, or
# the certificate order fails and Caddy retries on a backoff that looks like a
# hang.
ATM_DOMAIN=api.atm.example.com

# Where the certificate authority sends expiry warnings. A real mailbox someone
# reads: it is the only warning before a certificate that stopped renewing.
ATM_ACME_EMAIL=ops@example.com

# Where the gateway listens. Must match GATEWAY_PORT in gateway.env.
ATM_GATEWAY_ORIGIN=127.0.0.1:3100

# The dashboard's exact origin, scheme and host, no path and no trailing slash.
# It is compared literally against the browser's `Origin` header, and it is what
# the CORS response echoes back.
ATM_DASHBOARD_ORIGIN=https://atm.example.com

# The same host with no scheme, which is what a Caddy site address is. Spelled
# out rather than derived: a Caddyfile cannot strip the scheme off the line
# above, and a site address that still carries `https://` is one Caddy reads as
# a different site.
ATM_DASHBOARD_DOMAIN=atm.example.com

# Where the built SPA is on disk — the `dist` directory `vite build` writes,
# absolute. Caddy reads it as its own user, so every directory on the way in
# has to be traversable by that user.
ATM_DASHBOARD_ROOT=/opt/agent-task-manager/apps/dashboard/dist
