# /etc/agent-task-manager/caddy.env — what the Caddyfile reads.
#
# Copy, fill in, `chown root:caddy`, `chmod 0640`. Reached by Caddy through the
# drop-in in `caddy-override.conf`; the stock caddy.service reads no environment
# file of its own.

# The site address. Its A/AAAA record must already point at this host, or the
# certificate order fails and Caddy retries on a backoff that looks like a hang.
ATM_DOMAIN=api.example.com

# Where the certificate authority sends expiry warnings. A real mailbox someone
# reads: it is the only warning before a certificate that stopped renewing.
ATM_ACME_EMAIL=ops@example.com

# Where the gateway listens. Must match GATEWAY_PORT in gateway.env.
ATM_GATEWAY_ORIGIN=127.0.0.1:3100

# The dashboard's exact origin, scheme and host, no path and no trailing slash.
# It is compared literally against the browser's `Origin` header, and it is what
# the CORS response echoes back.
ATM_DASHBOARD_ORIGIN=https://dash.example.com
