# /etc/agent-task-manager/common.env — what both services need.
#
# Copy, fill in, `chown root:atm`, `chmod 0640`. Every value here is read by
# both the gateway and the loop, and the two disagreeing about any of them is a
# whole class of bug: a loop writing artifacts where the gateway does not look
# for them, or two processes on two databases.
#
# Systemd parses this file itself, not a shell. There is no expansion, no
# quoting, no comments after a value — `KEY=value` and nothing else.

# The database. Loopback because Compose binds Postgres to 127.0.0.1 only.
DATABASE_URL=postgres://user:CHANGEME@127.0.0.1:5432/agent_task_manager

# Artifacts, per-run agent homes, and the JSONL event ledger. Absolute: the
# repository checkout is read-only to both services, so the in-repo `.data`
# default cannot be written and must not be relied on.
DATA_ROOT=/var/lib/agent-task-manager

LOG_LEVEL=Info
LOG_FORMAT=logfmt

# Stamped on every telemetry event. Set GIT_SHA at deploy time — it is the only
# thing that answers "which build produced this row".
SERVICE_VERSION=0.0.1
GIT_SHA=

# Unset means no network call and no export; the JSONL ledger keeps working
# either way. OTEL_EXPORTER_OTLP_HEADERS carries the collector's token.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
