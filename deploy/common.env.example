# /etc/agent-task-manager/common.env — what both services need.
#
# Copy, fill in, `chown root:atm`, `chmod 0640`. Every value here is read by
# both the gateway and the loop, and the two disagreeing about any of them is a
# whole class of bug: a loop writing artifacts where the gateway does not look
# for them, or two processes on two databases.
#
# Systemd parses this file itself, not a shell. There is no expansion, no
# quoting, no comments after a value — `KEY=value` and nothing else.

# The database. Loopback because Compose binds Postgres to 127.0.0.1 only.
DATABASE_URL=postgres://user:CHANGEME@127.0.0.1:5432/agent_task_manager

# Run directories, checkouts, artifacts, and the JSONL event ledger. Absolute:
# the repository checkout is read-only to both services, so the in-repo `.data`
# default cannot be written and must not be relied on.
#
# The agent homes are deliberately not under this: they hold the provider
# logins, outlive every run, and are set in the loop's own env file.
DATA_ROOT=/var/lib/agent-task-manager

# The dashboard's exact origin: scheme and host, no path, no trailing slash.
# Read by more than one process, which is why it is here. The gateway trusts it
# as an origin the browser may post a cookie from, and the bot builds the link
# on every notification out of it — the gateway serves no pages, so a task link
# pointed at the API is a 404 in somebody's Telegram. Must be the same string as
# ATM_DASHBOARD_ORIGIN in caddy.env; the two are compared against the same
# header by different programs.
DASHBOARD_ORIGIN=https://dash.example.com

# The root secret, and all three processes need the *same* one. The gateway
# signs the browser's session cookie with it and verifies every scoped bearer
# token against a key derived from it; the loop mints one such token per run so
# a container can reach the board, and the bot mints one per message it relays.
# Generate with `openssl rand -base64 32`.
#
# It lives here rather than in gateway.env because of how it fails otherwise:
# the gateway boots fine on its own value, and the tokens the other two mint are
# simply rejected — a 401 on every board tool call, with nothing in any log
# saying the two sides disagree about a key. Rotating it is the only revocation
# there is; it logs everybody out and invalidates every outstanding token.
BETTER_AUTH_SECRET=CHANGEME

# The origin the auth library builds its callback and cookie URLs from. The same
# value as GATEWAY_PUBLIC_URL. Only the gateway serves those routes, but the
# loop and the bot each build an auth instance to reach the database and warn at
# every boot without it. Left unset it is guessed from each request, which works
# until something forwards a header that says otherwise. It is also what names
# the session cookie: over https the library issues it as
# __Secure-better-auth.session_token, which the gateway expects.
BETTER_AUTH_URL=https://api.atm.example.com

LOG_LEVEL=Info
LOG_FORMAT=logfmt

# Stamped on every telemetry event. Set GIT_SHA at deploy time — it is the only
# thing that answers "which build produced this row".
SERVICE_VERSION=0.0.1
GIT_SHA=

# Unset means no network call and no export; the JSONL ledger keeps working
# either way. OTEL_EXPORTER_OTLP_HEADERS carries the collector's token.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
