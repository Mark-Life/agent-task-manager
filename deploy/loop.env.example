# /etc/agent-task-manager/loop.env — what only the orchestrator loop needs.
#
# Copy, fill in, `chown root:atm`, `chmod 0640`. This is the file with the agent
# credentials in it, which is the reason the gateway does not read it.

# Isolation. `local` runs the agent as a host process with none of it and exists
# for a laptop; on a machine reachable from the internet it is not a setting, it
# is an incident.
SANDBOX_MODE=docker

# How many runs at once. Four cores and 8 GB, and every run is a container with
# a checkout and a model client in it — this is a memory ceiling long before it
# is a CPU one. Raise it by one and watch the host before raising it again.
ORCHESTRATOR_MAX_CONCURRENCY=2

# Chat runs on its own slots, so a conversation is never stuck behind two
# hour-long worker runs. The box's ceiling is the sum of the two. One is enough:
# a person holds one conversation at a time.
ORCHESTRATOR_MAX_CHAT_CONCURRENCY=1

# An hour per run, then the container is torn down and the run is failed. The
# default; stated here because it is the knob people look for first when a run
# dies at exactly sixty minutes.
ORCHESTRATOR_RUN_TIMEOUT_MS=3600000

# Ten minutes for a chat turn. A person is waiting on it, so a turn that has
# gone quiet should be ended and asked again rather than left running.
ORCHESTRATOR_CHAT_TIMEOUT_MS=600000

# The gateway as a *container* sees it, which on a docker host is not
# localhost. Unset, every turn runs with no board tools and the loop says so
# once at boot.
ORCHESTRATOR_GATEWAY_URL=http://host.docker.internal:3100

# How long the board credential a turn is given stays valid. It is minted per
# run and bound to that run's task, so this is the blast radius of a leaked one.
ORCHESTRATOR_AGENT_TOKEN_TTL_MS=900000

# Retry backoff and the giving-up point. After MAX_ATTEMPTS a task is parked for
# PARK_MS (a day) rather than retried forever — a model outage should cost a
# pause, not a thousand container starts.
ORCHESTRATOR_MAX_ATTEMPTS=5
ORCHESTRATOR_RETRY_BASE_MS=60000
ORCHESTRATOR_RETRY_MAX_MS=1800000
ORCHESTRATOR_PARK_MS=86400000

# One system-owned directory per provider, mounted read-write into every
# container at /agent-home. Not under DATA_ROOT and never copied: both CLIs
# refresh their subscription token in place, so a per-run copy discards the
# refresh with the container and leaves the original permanently stale.
#
# Create each one as the service user and log in once, by hand:
#   sudo -u atm CLAUDE_CONFIG_DIR=/var/lib/agent-task-manager-home/claude claude
#   sudo -u atm CODEX_HOME=/var/lib/agent-task-manager-home/codex codex login
# The directory must be mode 0700 and owned by the uid the containers run as;
# `harness:check` says so out loud when it is not.
ATM_AGENT_HOME_DIR_CLAUDE=/var/lib/agent-task-manager-home/claude
ATM_AGENT_HOME_DIR_CODEX=/var/lib/agent-task-manager-home/codex

# The GitHub credential, and the only one there is. The host's git uses it to
# clone and fetch a private repository, and the same value is handed to every
# container so `gh` is logged in and an agent's `git push` works.
#
# Unset, a public repository still clones and a private one fails by name. The
# loop says which of the two you have at boot.
#
# **Scope it to the repositories the board works on.** It is on the environment
# of a container running model-generated code, and the run's checkout — mounted
# read-write into that container — carries a credential helper naming it. An
# agent can read the token and use it for anything it is good for, which is why
# a fine-grained token over a few repositories is a different thing to lose than
# an account-wide one. A turn receives it as GH_TOKEN and GITHUB_TOKEN; the name
# here is different on purpose, so a GH_TOKEN the host exports for its own use
# is never what an agent is handed.
#
# **Whose token this is, is whose name the commits carry.** The loop reads the
# account behind it once at boot and authors every run's commits as that person,
# at their `users.noreply.github.com` address — so the branch links to a profile
# instead of to a string nobody can click. A token with no user behind it, an
# app installation token say, falls back to `Agent Task Manager
# <agent@atm.invalid>`, and so does an install with no token at all. The loop
# logs which identity it settled on.
ATM_GITHUB_TOKEN=

# Claude runs on subscription auth by default and needs nothing here. Set the
# key only for headless use, where there is no login to inherit.
ANTHROPIC_API_KEY=
CLAUDE_SETTINGS_JSON=

# Stopping the loop stops containers and releases leases. Must stay under the
# unit's TimeoutStopSec.
LOOP_SHUTDOWN_GRACE_MS=45000
