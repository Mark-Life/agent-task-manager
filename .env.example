# Copy to .env (git-ignored) and fill in real values. Read by packages/env
# (packages/env/src/server.ts for Effect services, packages/env/src/web.ts for apps/web)
# and, independently, by packages/telemetry for the LOG_*/OTEL_*/EVENT_LOG_DIR set.

# --- Database -----------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/agent_task_manager # Postgres connection string, secret

# docker-compose.yml reads these for the local Postgres container and falls back
# to the same values DATABASE_URL above encodes. Override them only together
# with DATABASE_URL, or the app and the container disagree.
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
# POSTGRES_DB=agent_task_manager
# POSTGRES_PORT=5432

# --- Data root ------------------------------------------------------------
DATA_ROOT=.data # root directory for artifacts, per-run agent homes, and the event ledger

# --- Auth -----------------------------------------------------------------
# One secret, two jobs: Better Auth signs session cookies with it, and the
# gateway signs its scoped bearer tokens under a key derived from it. Required
# by apps/gateway — it will not start without one. Rotating it invalidates every
# session and every outstanding token at once, which is the only revocation
# there is. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET= # secret, required by apps/gateway

# --- Gateway --------------------------------------------------------------
# All three have defaults, so a local run needs none of them. Left commented
# out for the reason the telemetry block gives: an empty value reads as unset to
# Effect's Config and as an empty string to a plain shell reader.
# GATEWAY_PORT= # what the server binds, default: 3100
# GATEWAY_PUBLIC_URL= # the origin written into the served spec's `servers`, default: http://localhost:${GATEWAY_PORT}
# GATEWAY_SHUTDOWN_GRACE_MS= # how long a graceful stop gets before it exits hard, default: 15000

# --- Sandbox --------------------------------------------------------------
# SANDBOX_MODE=docker # docker | local; local runs a host process with no isolation at all

# --- Telegram bot (apps/bot) ------------------------------------------------
TELEGRAM_BOT_TOKEN= # bot token from @BotFather, secret, required only by apps/bot

# Who the bot answers to, as telegramUserId:workspaceId:userId entries separated
# by commas. There is no link-code flow: this list is the whole identity story.
# A malformed entry fails the bot's boot rather than dropping one person's
# messages silently.
TELEGRAM_ALLOWLIST= # e.g. 12345678:org_abc:user_abc,87654321:org_abc:user_def, required by apps/bot

GROQ_API_KEY= # Groq key for voice-note transcription, secret; unset = voice notes are refused, text still works

# The renderer and the process, all defaulted.
# BOT_GATEWAY_URL= # the gateway as the bot process reaches it, for a tapped button, default: http://localhost:3100
# BOT_SHUTDOWN_GRACE_MS= # how long a graceful stop gets before it exits hard, default: 15000
# BOT_DRAFT_INTERVAL_MS= # how often a streaming reply is edited into Telegram, default: 300
# BOT_SPLIT_AT= # characters before a reply is split into a second message, default: 4000

# --- Manager agent (apps/bot) -----------------------------------------------
# The gateway URL here is the one the *container* resolves, which is not the
# host's under SANDBOX_MODE=docker: http://host.docker.internal:3100 on macOS,
# the bridge address or a published one on Linux.
# MANAGER_GATEWAY_URL= # default: http://localhost:3100
# MANAGER_PROVIDER= # claude | codex, default: claude
# MANAGER_MODEL= # unset = the provider's own default
# MANAGER_TURN_TIMEOUT_MS= # cap on one manager turn, default: 300000
# MANAGER_TOKEN_TTL_MS= # lifetime of the per-turn gateway token, short because nothing can recall one, default: 900000
# MANAGER_HISTORY_MESSAGES= # rows of chat history put in the prompt, default: 40

# --- Notifications (apps/bot) -----------------------------------------------
# A notice about a run is announced into the conversation that asked for it, and
# GATEWAY_PUBLIC_URL above is what turns the task id on it into a link. Unset,
# the message carries the id and no link.
# NOTIFY_RETRY_GRACE_MS= # how long a claimed-but-undelivered notice waits before a retry, default: 60000
# NOTIFY_REPAIR_INTERVAL_MS= # how often undelivered claims are looked for, default: 60000

# --- Stuck-run heuristic (apps/bot) -----------------------------------------
# All four are thresholds the detection reads, never literals in its code.
# STUCK_SCAN_INTERVAL_MS= # how often live runs are scanned, default: 60000
# STUCK_WINDOW_MINUTES= # the trailing window the rule looks at, default: 10
# STUCK_MIN_TOOL_CALLS= # tool calls in the window before a run can be called stuck, default: 6
# STUCK_DISTINCT_SIGNATURES= # distinct tool signatures at or below which it is repeating itself, default: 2

# --- Agent providers --------------------------------------------------------
ANTHROPIC_API_KEY= # optional Claude fallback when not using subscription login, secret
CLAUDE_SETTINGS_JSON= # optional JSON overlay merged onto the hardened default Claude Agent SDK settings

# --- Executor MCP (executor.sh) --------------------------------------------
EXECUTOR_MCP_URL= # org-scoped MCP endpoint from the Executor dashboard, e.g. https://executor.sh/org_xxx/mcp
EXECUTOR_MCP_KEY= # Executor API key, sent as an MCP auth header, secret

# --- Telemetry (read directly by packages/telemetry, see its Config calls) -
# A variable with a default is left commented out: an empty value reads as unset
# to Effect's Config but as a real empty string to a plain shell reader, and the
# two then disagree about where the ledger lives.
# LOG_FORMAT= # pretty | logfmt | json, default: pretty on a TTY, logfmt otherwise
LOG_LEVEL=Info # All | Fatal | Error | Warn | Info | Debug | Trace | None
# EVENT_LOG_DIR= # wide-event JSONL directory, default: ${DATA_ROOT}/events
OTEL_EXPORTER_OTLP_ENDPOINT= # optional OTLP collector base URL (Axiom, Grafana, a local collector); unset = no network call
OTEL_EXPORTER_OTLP_HEADERS= # comma-separated k=v pairs sent as OTLP headers, e.g. Authorization=Bearer xxx, secret
SERVICE_VERSION= # stamped on every telemetry event, e.g. from package.json or a release tag
GIT_SHA= # stamped on every telemetry event, e.g. $(git rev-parse HEAD) at deploy time
