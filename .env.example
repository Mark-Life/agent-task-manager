# Copy to .env (git-ignored) and fill in real values. Read by packages/env
# (packages/env/src/server.ts for Effect services, packages/env/src/web.ts for apps/web)
# and, independently, by packages/telemetry for the LOG_*/OTEL_*/EVENT_LOG_DIR set.

# --- Database -----------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/agent_task_manager # Postgres connection string, secret

# docker-compose.yml reads these for the local Postgres container and falls back
# to the same values DATABASE_URL above encodes. Override them only together
# with DATABASE_URL, or the app and the container disagree.
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
# POSTGRES_DB=agent_task_manager
# POSTGRES_PORT=5432

# --- Data root ------------------------------------------------------------
DATA_ROOT=.data # root directory for run directories, checkouts, artifacts, and the event ledger

# --- Agent homes ------------------------------------------------------------
# One system-owned directory per provider, mounted read-write into every
# container at /agent-home. It is NOT under DATA_ROOT and it is never copied:
# both CLIs refresh their subscription token in place, so a private per-run copy
# throws the refresh away with the container and leaves the original stale.
#
# Create and log into each one once, by hand:
#   bun run scripts/agent-home-login.ts claude
#   CLAUDE_CONFIG_DIR=~/.claude-task-management claude   # then /login
#   CODEX_HOME=~/.codex-task-management codex login
# `bun run harness:check` is what tells you whether that worked.
#
# Deliberately not named CLAUDE_CONFIG_DIR / CODEX_HOME: those relocate the
# config directory of whatever process exports them, including yours.
# ATM_AGENT_HOME_DIR_CLAUDE= # default: ~/.claude-task-management
# ATM_AGENT_HOME_DIR_CODEX= # default: ~/.codex-task-management

# --- Auth -----------------------------------------------------------------
# One secret, three jobs: Better Auth signs session cookies with it, the gateway
# signs its scoped bearer tokens under a key derived from it, and a project's
# environment files are sealed under a second derived key. Required by
# apps/gateway and apps/loop — neither starts without one. Rotating it
# invalidates every session and every outstanding token at once, which is the
# only revocation there is, and it makes every stored env file unreadable until
# they are re-sealed. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET= # secret, required by apps/gateway and apps/loop

# The origin the auth library builds its cookie and callback URLs from — the
# gateway's public one, the same value as GATEWAY_PUBLIC_URL. Left unset it is
# guessed per request, which works until something forwards a header that says
# otherwise. Required whenever AUTH_COOKIE_DOMAIN is set: auth refuses to start
# on a cookie domain with no base URL, because without one it cannot tell it is
# serving https and would widen the session cookie without the Secure flag.
# BETTER_AUTH_URL= # e.g. https://api.example.com; unset locally

# The dashboard's exact origin: scheme and host, no path, no trailing slash.
# Better Auth compares it literally against the browser's `Origin` header and
# answers 403 to a cookie-bearing POST from anywhere else, and the bot builds
# the link on a notification out of it — the gateway serves no pages, so a task
# link pointed at the gateway is a 404.
#
# Required locally too, and the dev server's own address is the value. The Vite
# proxy makes the API look same-origin to application code, but the browser
# still stamps the dev server's origin on every request while the proxy rewrites
# the host to the gateway's — so the two never match on their own and sign-in is
# refused with `Invalid origin` until this is set.
DASHBOARD_ORIGIN=http://localhost:5173 # in deployment, e.g. https://dash.example.com

# The registrable domain the dashboard and the gateway share, leading dot
# included. Set, the session cookie is scoped to it and the two hosts are one
# site to the browser, so no third-party cookie is involved and nothing is
# dropped. Unset, the cookie stays on the gateway's own host — right locally,
# and right for a deployment served from a single origin.
# AUTH_COOKIE_DOMAIN= # e.g. .example.com

# The password the seed gives the owner account. Sign-up is closed, so this is
# the only way a person gets a login; unset, the owner row exists and cannot
# sign in. Change it after the first login by hand — re-seeding never overwrites
# a password that is already there.
OWNER_PASSWORD= # secret, read by `bun run db:seed`

# --- Gateway --------------------------------------------------------------
# All three have defaults, so a local run needs none of them. Left commented
# out for the reason the telemetry block gives: an empty value reads as unset to
# Effect's Config and as an empty string to a plain shell reader.
# GATEWAY_PORT= # what the server binds, default: 3100
# GATEWAY_PUBLIC_URL= # the origin written into the served spec's `servers`, default: http://localhost:${GATEWAY_PORT}
# GATEWAY_SHUTDOWN_GRACE_MS= # how long a graceful stop gets before it exits hard, default: 15000

# --- Sandbox --------------------------------------------------------------
# SANDBOX_MODE=docker # docker | local; local runs a host process with no isolation at all

# A ceiling, not a reservation: docker allocates none of it up front, so the sum
# of every slot's limit may exceed the box and routinely should. What it decides
# is which process dies when a run goes wrong — a container over its own limit
# is OOM-killed, counted and retried; the host over its memory is the kernel
# picking a victim, possibly Postgres. Size it for the largest legitimate run,
# not the typical one: a worker whose agent fans out into sub-agents spends the
# whole of it inside this one container.
# SANDBOX_MEMORY_MB= # per-container memory ceiling, swap pinned to the same number, default: 2048

# The same idea, and cheaper to overcommit: a quota is a share of time rather
# than a claim on a core, and an agent waiting on a model spends none of it.
# Over-committed CPU is contention; over-committed memory is a kill.
# SANDBOX_CPUS= # per-container CPU quota, fractional, default: 1.5

# --- Orchestrator loop (apps/loop) ------------------------------------------
# Read by packages/orchestrator/src/config.ts, which is the only reader. Every
# one is defaulted, so a laptop needs none of them — except the gateway URL,
# without which a turn runs with no board tools and the loop says so at boot.
# ORCHESTRATOR_GATEWAY_URL= # the gateway as a *container* reaches it, e.g. http://host.docker.internal:3100
# ORCHESTRATOR_MAX_CONCURRENCY= # worker runs at once, default: 2
# ORCHESTRATOR_MAX_CHAT_CONCURRENCY= # manager turns at once, on their own slots so a conversation never waits on a worker, default: 2
# ORCHESTRATOR_RUN_TIMEOUT_MS= # cap on one worker run, default: 86400000 (24h)
# ORCHESTRATOR_CHAT_TIMEOUT_MS= # cap on one manager turn — a reply into a conversation, with a person waiting, default: 1800000 (30m)
# ORCHESTRATOR_AGENT_TOKEN_TTL_MS= # lifetime of one gateway token, default: 900000 (15m); the turn's credential is re-minted three times per lifetime for as long as the run lasts, so this is the blast radius of a leaked one and not the run's reach

# --- Telegram bot (apps/bot) ------------------------------------------------
TELEGRAM_BOT_TOKEN= # bot token from @BotFather, secret, required only by apps/bot

# Who the bot answers to, as telegramUserId:workspaceId:userId entries separated
# by commas. There is no link-code flow: this list is the whole identity story.
# A malformed entry fails the bot's boot rather than dropping one person's
# messages silently.
TELEGRAM_ALLOWLIST= # e.g. 12345678:org_abc:user_abc,87654321:org_abc:user_def, required by apps/bot

GROQ_API_KEY= # Groq key for voice-note transcription, secret; unset = voice notes are refused, text still works

# The renderer and the process, all defaulted.
# BOT_GATEWAY_URL= # the gateway as the bot process reaches it, for a tapped button, default: http://localhost:3100
# BOT_SHUTDOWN_GRACE_MS= # how long a graceful stop gets before it exits hard, default: 15000
# BOT_SPLIT_AT= # characters before a reply is split into a second message, default: 4000

# The bot says one line into every allow-listed chat when it starts, and one on
# the way out when the stop was graceful enough to send it. The quiet window is
# the only thing keeping a crash loop or a rolling deploy from repeating either,
# and it is counted on the notification ledger, so it survives the restart.
# BOT_ANNOUNCE_RESTART= # whether the bot announces its own restarts, default: true
# BOT_ANNOUNCE_QUIET_MS= # minimum gap between two announcements of the same kind, default: 900000 (15m)

# --- Notifications (apps/bot) -----------------------------------------------
# A notice about a run is announced into the conversation that asked for it, and
# GATEWAY_PUBLIC_URL above is what turns the task id on it into a link. Unset,
# the message carries the id and no link.
# NOTIFY_RETRY_GRACE_MS= # how long a claimed-but-undelivered notice waits before a retry, default: 60000
# NOTIFY_REPAIR_INTERVAL_MS= # how often undelivered claims are looked for, default: 60000

# --- Stuck-run heuristic (apps/bot) -----------------------------------------
# All four are thresholds the detection reads, never literals in its code.
# STUCK_SCAN_INTERVAL_MS= # how often live runs are scanned, default: 60000
# STUCK_WINDOW_MINUTES= # the trailing window the rule looks at, default: 10
# STUCK_MIN_TOOL_CALLS= # tool calls in the window before a run can be called stuck, default: 6
# STUCK_DISTINCT_SIGNATURES= # distinct tool signatures at or below which it is repeating itself, default: 2

# --- The GitHub credential agents are handed -------------------------------
# One token: the host's git clones private repositories with it, and every
# container gets it as GH_TOKEN and GITHUB_TOKEN, so `gh` is logged in and an
# agent can push and open a pull request. Deliberately not named GH_TOKEN — a
# token exported for your own shell is not thereby given to every agent.
#
# Mint it with `repo` and `workflow` at minimum, plus `admin:repo_hook`,
# `read:org` and `delete_repo` for tasks about a repository's settings. Without
# `workflow`, GitHub rejects every push touching `.github/workflows/`. On a
# `gh auth login` token, widening is a re-consent:
#   gh auth refresh -h github.com -s repo,workflow,admin:repo_hook,read:org,delete_repo
# `bun run github:check` prints what the configured token can do, and
# `.docs/github-credential.md` is the whole story.
ATM_GITHUB_TOKEN= # secret; scope it to the repositories the board works on

# --- Agent providers --------------------------------------------------------
ANTHROPIC_API_KEY= # optional Claude fallback when not using subscription login, secret
CLAUDE_SETTINGS_JSON= # optional JSON overlay merged onto the hardened default Claude Agent SDK settings

# --- Executor MCP (executor.sh) --------------------------------------------
EXECUTOR_MCP_URL= # org-scoped MCP endpoint from the Executor dashboard, e.g. https://executor.sh/org_xxx/mcp
EXECUTOR_MCP_KEY= # Executor API key, sent as an MCP auth header, secret

# --- Telemetry (read directly by packages/telemetry, see its Config calls) -
# A variable with a default is left commented out: an empty value reads as unset
# to Effect's Config but as a real empty string to a plain shell reader, and the
# two then disagree about where the ledger lives.
# LOG_FORMAT= # pretty | logfmt | json, default: pretty on a TTY, logfmt otherwise
LOG_LEVEL=Info # All | Fatal | Error | Warn | Info | Debug | Trace | None
# EVENT_LOG_DIR= # wide-event JSONL directory, default: ${DATA_ROOT}/events
OTEL_EXPORTER_OTLP_ENDPOINT= # optional OTLP collector base URL (Axiom, Grafana, a local collector); unset = no network call
OTEL_EXPORTER_OTLP_HEADERS= # comma-separated k=v pairs sent as OTLP headers, e.g. Authorization=Bearer xxx, secret
SERVICE_VERSION= # stamped on every telemetry event, e.g. from package.json or a release tag
GIT_SHA= # stamped on every telemetry event, e.g. $(git rev-parse HEAD) at deploy time
