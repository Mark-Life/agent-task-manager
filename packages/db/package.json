{
  "name": "@workspace/db",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./testing/root-env": "./src/testing/root-env.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "db:generate": "bun run scripts/migrations-check.ts && drizzle-kit generate",
    "db:migrations-check": "bun run scripts/migrations-check.ts",
    "auth:generate": "bunx --bun auth@$(bun -p \"require('./package.json').dependencies['better-auth']\") generate --config ./src/auth/cli.ts --output ./src/schema/auth.ts --yes && bun run scripts/auth-schema-index.ts && bunx --bun ultracite fix ./src/schema/auth.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.0-rc.2",
    "@better-auth/drizzle-adapter": "1.7.0-rc.2",
    "@effect/sql-pg": "catalog:",
    "@workspace/domain": "workspace:*",
    "@workspace/token": "workspace:*",
    "better-auth": "1.7.0-rc.2",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "catalog:",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/pg": "^8.20.3",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "1.0.0-rc.4"
  }
}
