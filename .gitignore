# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Data root: artifacts, per-run agent homes, event ledger
.data

# Backup sets. A sibling of the data root rather than a child, so deleting the
# data root does not delete its own backups. Holds password hashes and the
# encrypted project environment, so it is never a thing to commit.
.data-backups

# Atlas: generated repository map and its viewer
.atlas/

# Vercel
.vercel

# Alchemy: deployment state, logs, bundles, local emulation data
.alchemy/

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*

# Misc
.DS_Store
*.pem

# TypeScript
*.tsbuildinfo
